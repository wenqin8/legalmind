                "candidates": [
                  {
                    "source_id": "847ef962-2a02-5399-b5c6-4785de46475d",
                    "source": {
                      "source_type": "legal_provision",
                      "source_id": "847ef962-2a02-5399-b5c6-4785de46475d",
                      "title": "中华人民共和国民法典",
                      "reference_number": "第四百九十七条",
                      "publisher": "最高人民法院",
                      "date": "2020-05-28",
                      "sample_date": null,
                      "source_url": "https://www.court.gov.cn/zixun/xiangqing/233181.html",
                      "source_kind": "official",
                      "is_demo": false,
                      "is_synthetic": false,
                      "citation_id": "S1",
                      "version": "2020年制定",
                      "effective_from": "2021-01-01",
                      "effective_until": null,
                      "verified_at": "2026-09-18",
                      "status_as_of": "2026-03-12",
                      "legal_status": "effective",
                      "original_text": "第四百九十七条　有下列情形之一的，该格式条款无效：\n（一）具有本法第一编第六章第三节和本法第五百零六条规定的无效情形；\n（二）提供格式条款一方不合理地免除或者减轻其责任、加重对方责任、限制对方主要权利；\n（三）提供格式条款一方排除对方主要权利。",
                      "applicability": "general_reference",
                      "temporal_rule": "event_date",
                      "transition_text": null
                    },
                    "spans": [
                      {
                        "span_id": 0,
                        "text": "第四百九十七条　有下列情形之一的，该格式条款无效："
                      },
                      {
                        "span_id": 1,
                        "text": "（一）具有本法第一编第六章第三节和本法第五百零六条规定的无效情形；"
                      },
                      {
                        "span_id": 2,
                        "text": "（二）提供格式条款一方不合理地免除或者减轻其责任、加重对方责任、限制对方主要权利；"
                      },
                      {
                        "span_id": 3,
                        "text": "（三）提供格式条款一方排除对方主要权利。"
                      }
                    ]
                  },
                  {
                    "source_id": "c850d36b-c479-5894-9bed-332c26596014",
                    "source": {
                      "source_type": "legal_provision",
                      "source_id": "c850d36b-c479-5894-9bed-332c26596014",
                      "title": "中华人民共和国民法典",
                      "reference_number": "第四百九十六条",
                      "publisher": "最高人民法院",
                      "date": "2020-05-28",
                      "sample_date": null,
                      "source_url": "https://www.court.gov.cn/zixun/xiangqing/233181.html",
                      "source_kind": "official",
                      "is_demo": false,
                      "is_synthetic": false,
                      "citation_id": "S2",
                      "version": "2020年制定",
                      "effective_from": "2021-01-01",
                      "effective_until": null,
                      "verified_at": "2026-09-18",
                      "status_as_of": "2026-03-12",
                      "legal_status": "effective",
                      "original_text": "第四百九十六条　格式条款是当事人为了重复使用而预先拟定，并在订立合同时未与对方协商的条款。\n采用格式条款订立合同的，提供格式条款的一方应当遵循公平原则确定当事人之间的权利和义务，并采取合理的方式提示对方注意免除或者减轻其责任等与对方有重大利害关系的条款，按照对方的要求，对该条款予以说明。提供格式条款的一方未履行提示或者说明义务，致使对方没有注意或者理解与其有重大利害关系的条款的，对方可以主张该条款不成为合同的内容。",
                      "applicability": "general_reference",
                      "temporal_rule": "event_date",
                      "transition_text": null
                    },
                    "spans": [
                      {
                        "span_id": 0,
                        "text": "第四百九十六条　格式条款是当事人为了重复使用而预先拟定，并在订立合同时未与对方协商的条款。"
                      },
                      {
                        "span_id": 1,
                        "text": "采用格式条款订立合同的，提供格式条款的一方应当遵循公平原则确定当事人之间的权利和义务，并采取合理的方式提示对方注意免除或者减轻其责任等与对方有重大利害关系的条款，按照对方的要求，对该条款予以说明。"
                      },
                      {
                        "span_id": 2,
                        "text": "提供格式条款的一方未履行提示或者说明义务，致使对方没有注意或者理解与其有重大利害关系的条款的，对方可以主张该条款不成为合同的内容。"
                      }
                    ]
                  },
                  {
                    "source_id": "16fac49b-976b-5426-a42e-0e5bac7acf9b",
                    "source": {
                      "source_type": "legal_provision",
                      "source_id": "16fac49b-976b-5426-a42e-0e5bac7acf9b",
                      "title": "最高人民法院关于适用《中华人民共和国民法典》合同编通则若干问题的解释",
                      "reference_number": "第十条",
                      "publisher": "最高人民法院",
                      "date": "2023-12-04",
                      "sample_date": null,
                      "source_url": "https://www.court.gov.cn/fabu/xiangqing/419382.html",
                      "source_kind": "official",
                      "is_demo": false,
                      "is_synthetic": false,
                      "citation_id": "S3",
                      "version": "2023年制定",
                      "effective_from": "2023-12-05",
                      "effective_until": null,
                      "verified_at": "2026-09-19",
                      "status_as_of": "2023-12-05",
                      "legal_status": "effective",
                      "original_text": "第十条 提供格式条款的一方在合同订立时采用通常足以引起对方注意的文字、符号、字体等明显标识，提示对方注意免除或者减轻其责任、排除或者限制对方权利等与对方有重大利害关系的异常条款的，人民法院可以认定其已经履行民法典第四百九十六条第二款规定的提示义务。\n提供格式条款的一方按照对方的要求，就与对方有重大利害关系的异常条款的概念、内容及其法律后果以书面或者口头形式向对方作出通常能够理解的解释说明的，人民法院可以认定其已经履行民法典第四百九十六条第二款规定的说明义务。\n提供格式条款的一方对其已经尽到提示义务或者说明义务承担举证责任。对于通过互联网等信息网络订立的电子合同，提供格式条款的一方仅以采取了设置勾选、弹窗等方式为由主张其已经履行提示义务或者说明义务的，人民法院不予支持，但是其举证符合前两款规定的除外。",
                      "applicability": "general_reference",
                      "temporal_rule": "event_date",
                      "transition_text": null
                    },
                    "spans": [
                      {
                        "span_id": 0,
                        "text": "第十条 提供格式条款的一方在合同订立时采用通常足以引起对方注意的文字、符号、字体等明显标识，提示对方注意免除或者减轻其责任、排除或者限制对方权利等与对方有重大利害关系的异常条款的，人民法院可以认定其已经履行民法典第四百九十六条第二款规定的提示义务。"
                      },
                      {
                        "span_id": 1,
                        "text": "提供格式条款的一方按照对方的要求，就与对方有重大利害关系的异常条款的概念、内容及其法律后果以书面或者口头形式向对方作出通常能够理解的解释说明的，人民法院可以认定其已经履行民法典第四百九十六条第二款规定的说明义务。"
                      },
                      {
                        "span_id": 2,
                        "text": "提供格式条款的一方对其已经尽到提示义务或者说明义务承担举证责任。"
                      },
                      {
                        "span_id": 3,
                        "text": "对于通过互联网等信息网络订立的电子合同，提供格式条款的一方仅以采取了设置勾选、弹窗等方式为由主张其已经履行提示义务或者说明义务的，人民法院不予支持，但是其举证符合前两款规定的除外。"
                      }
                    ]
                  },
