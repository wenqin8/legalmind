# Copy this file to .env for local development. Never commit .env.
LEGALMIND_ENVIRONMENT=development
LEGALMIND_DEBUG=false
LEGALMIND_LOG_LEVEL=INFO

# M3 daily development stays on SQLite; PostgreSQL compatibility is verified
# with isolated schemas via the smoke URL. Never commit a real password here.
LEGALMIND_DATABASE_URL=sqlite:///./data/legalmind.db
LEGALMIND_POSTGRES_PASSWORD=
LEGALMIND_POSTGRES_SMOKE_URL=
# Redis is required for chat/history. Blank URL defaults to localhost:6379/0.
# Use ensure_local_infrastructure_secrets.py for authenticated local services.
LEGALMIND_REDIS_PASSWORD=
LEGALMIND_REDIS_URL=
LEGALMIND_CHROMA_PERSIST_DIRECTORY=./data/chroma
LEGALMIND_EMBEDDING_BACKEND=sentence_transformers
LEGALMIND_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
LEGALMIND_EMBEDDING_MODEL_REVISION=7999e1d3359715c523056ef9478215996d62a620
LEGALMIND_EMBEDDING_DIMENSION=512
LEGALMIND_EMBEDDING_DEVICE=cpu
LEGALMIND_EMBEDDING_CACHE_DIRECTORY=./data/models
LEGALMIND_CHROMA_COLLECTION_NAME=legal_knowledge_v1

# Generate a random value of at least 32 characters in the ignored local .env.
LEGALMIND_JWT_SECRET_KEY=
LEGALMIND_JWT_ISSUER=legalmind-api
LEGALMIND_JWT_AUDIENCE=legalmind-web
LEGALMIND_ACCESS_TOKEN_EXPIRE_MINUTES=60

# JSON array. Explicit origins are required because credentials are enabled.
LEGALMIND_CORS_ORIGINS=["http://localhost:5173"]

# Fake mode is offline and conservatively returns insufficient evidence.
# Configure a local DeepSeek key for real M3 model integration.
LEGALMIND_LLM_BACKEND=fake
LEGALMIND_DEEPSEEK_BASE_URL=https://api.deepseek.com
LEGALMIND_DEEPSEEK_API_KEY=
LEGALMIND_DEEPSEEK_MODEL=deepseek-v4-flash
# Disabled by default so temperature is effective and output tokens remain predictable.
LEGALMIND_DEEPSEEK_THINKING_ENABLED=false
LEGALMIND_DEEPSEEK_TIMEOUT_SECONDS=60
LEGALMIND_LLM_TEMPERATURE=0.2
LEGALMIND_LLM_MAX_TOKENS=2048

# Per-client fixed-window limits for one local API worker.
LEGALMIND_AUTH_RATE_LIMIT_PER_MINUTE=20
LEGALMIND_BUSINESS_RATE_LIMIT_PER_MINUTE=120
